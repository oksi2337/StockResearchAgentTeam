ANTHROPIC_API_KEY=your_api_key_here
PORT=3001
FRED_API_KEY=                     # 선택: TIPS 실질금리·HY 스프레드. https://fred.stlouisfed.org/docs/api/api_key.html

# Discord 봇 설정
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# Discord 채널 ID
DISCORD_CH_MARKET_ALERT=channel_id_here
DISCORD_CH_DAILY_SUMMARY=channel_id_here
DISCORD_CH_STOCK_ANALYSIS=channel_id_here
DISCORD_CH_SECTOR_TREND=channel_id_here

# 뉴스레터 자동화
NOTION_API_KEY=                  # https://www.notion.so/my-integrations 에서 생성
NOTION_DATABASE_ID_A=            # 뉴스레터 A(글로벌 정치·경제) 전용 Notion DB ID
NOTION_DATABASE_ID_B=            # 뉴스레터 B(AI 트렌드) 전용 Notion DB ID
STIBEE_API_KEY=                  # Stibee 계정 설정 > API
STIBEE_LIST_ID_A=                # A 뉴스레터 구독자 목록 ID
STIBEE_LIST_ID_B=                # B 뉴스레터 구독자 목록 ID

# Gmail SMTP 발송 (newsletter_send.py)
GMAIL_USER=                      # 발신 Gmail 주소
GMAIL_APP_PASSWORD=              # Gmail 앱 비밀번호 (16자리, 계정 > 보안 > 2단계 인증 > 앱 비밀번호)
